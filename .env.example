# NERV — copy to .env and fill in. Every value here is optional except the ones you use.

# ---- brains ----
# Legacy provider variables below are ignored by the production VLM registry.
# Enter keys in the Models and API keys panel; ~/.nerv/credentials.json is authoritative.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
NERV_DEFAULT_BRAIN=deepseek-flash  # registered visual model ID; UI selection takes precedence

# ---- scenes and policies are submodules (worlds/, policies/): nothing to point at.
#      git submodule update --init --recursive
NERV_LEROBOT_PYTHON=               # only for the real SO-101: an interpreter with lerobot installed (empty = this venv)

# ---- launched nodes ----
NERV_NODE_PORTS=8112-8131
NERV_NODE_BIND_HOST=127.0.0.1
NERV_NODE_HEALTH_WAIT_S=60
NERV_TRUST_ALL=0                   # 1 = skip manifest approval (development only)
NERV_ALLOW_UNVERIFIED=0            # 1 = allow bus endpoints marked verified:false (they start disarmed)

# ---- the real arm (bodies/arm-lerobot-so101) ----
SO101_PORT=                        # e.g. /dev/ttyACM0
SO101_ID=                          # the id you calibrated with lerobot-calibrate
SO101_CAMERAS=                     # e.g. wrist=0,top=2
SO101_MAX_RELATIVE_TARGET=         # degrees per write; empty = LeRobot default
G1_ROBOT_IP=                       # unverified G1 endpoint

# ---- the turn loop ----
NERV_MAX_STEPS=60
NERV_TURN_TIME_BUDGET_S=900
NERV_CONTEXT_BUDGET=6000
NERV_CORS_ORIGINS=http://localhost:8100
NERV_SERVE_PORT=8000
NERV_SCENE_ENTRY_TIMEOUT_S=6
NERV_SCENE_ENTRY_POLL_S=0.1

# ---- modular harness / visual registry ----
# Legacy key placeholder; do not put new VLM credentials in this file.
DEEPSEEK_API_KEY=
NERV_HOME=                       # private VLM registry and write-only credentials; empty = ~/.nerv
NERV_REQUEST_TOKEN_BUDGET=32768   # complete estimated request budget, including output reservation
NERV_IMAGE_TOKEN_ALLOWANCE=2048   # estimated allowance per current image; not provider billing
NERV_SUPERVISION_WAIT_S=1
NERV_RUNTIME_STREAM_FPS=12
SO101_CAMERA_CONFIG=              # native LeRobot camera JSON: top/wrist geometry must match training
SO101_ACT_CHECKPOINT=             # original frozen 100000/pretrained_model directory
# Runtime control_rate_hz / max_runtime_s / supervision_timeout_s / freshness and
# cancellation deadlines belong to the binding settings in body.yaml.
# Old model/driver entries above are retained for history; production model choice
# uses the VLM registry. New real adapters use isolated environments.

# Simulation rendering is configured in the worker environment; no GPU is required.
# For CPU Mesa EGL set MUJOCO_GL=egl and LIBGL_ALWAYS_SOFTWARE=1 in your launch environment.
# If the machine has multiple EGL vendors, set __EGL_VENDOR_LIBRARY_FILENAMES to its Mesa manifest.
# Leave workstation-specific library paths out of robot/world descriptors.
NERV_ROBOT_EVENTS_POLL_S=0.5     # UI event refresh; local motion supervision has separate deadlines

# Existing LeRobot calibration directory; never recalibrated automatically.
SO101_CALIBRATION_DIR=
